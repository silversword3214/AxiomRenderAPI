{
  "schemaVersion": 1,
  "id": "axiomrenderapi",
  "version": "${version}",
  "name": "AxiomRenderAPI",
  "description": "Minecraft Fabric 1.21.11 rendering API for my ProjectAxiom -client",
  "authors": [],
  "contact": {},
  "license": "Apache-2.0",
  "environment": "client",
  "entrypoints": {

    "client": [
      "com.silversword3214.axiomrenderapi.AxiomMod"
    ]
  },
  "mixins": [
    "axiomrenderapi.client.mixins.json",
